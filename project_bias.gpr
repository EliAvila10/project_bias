with "config/project_bias_config.gpr";
project Project_Bias is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Project_Bias_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("project_bias.adb");

   package Compiler is
      for Default_Switches ("Ada") use Project_Bias_Config.Ada_Compiler_Switches;
   end Compiler;

      package Linker is
      for Default_Switches ("ada") use ("C:/Windows/System32/BCryptPrimitives.dll");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Project_Bias;
